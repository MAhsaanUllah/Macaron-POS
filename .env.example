# Local desktop defaults. The Electron shell injects its own values at runtime
# (see desktop/php-server.cjs); this file is only for the plain `php artisan serve`
# workshop path, which uses a different database than the shipped app.
APP_NAME=Macaron
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=720

# Shell-only overrides (normally set by Electron, not by hand):
# APP_STORAGE_PATH, MACARON_DATA_DIR, MACARON_SHELL, MACARON_PUBLIC, MACARON_LAN_URL
